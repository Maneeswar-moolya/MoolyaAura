# Register an application from the dashboard before selecting it.
# Supply only the credential VARIABLE NAMES declared for that environment.
# Copy to .env locally if needed; .env is ignored. Never commit credential values.
# Example names for a future application (not an installed project):
# APPLICATION_EMAIL=
# APPLICATION_PASSWORD=
# AURA_APPLICATION=<registered-application-id>
# AURA_ENVIRONMENT=<registered-environment-id>

# Optional exploration account. APP is the uppercase applicationId, with hyphens
# replaced by underscores. Without overrides, use its declared test credentials.
# APP_EXPLORATION_USER=
# APP_EXPLORATION_PASSWORD=
# APP_EXPLORATION_PROFILE=qa-user
# APP_QA_USER_EMAIL=
# APP_QA_USER_PASSWORD=

# Data creation requires explicit opt-in for the active application.
# APP_ALLOW_DATA_MUTATION=1
# EXCEL_WORKERS=1
# CLAUDE_CLI=<path-to-installed-Claude-CLI>
