# Copy to .env and fill in. .env is git-ignored; this file is committed.
#
# Use a dedicated QA account, not a personal one: the suite makes real failed
# sign-in attempts (TC_LOGIN_002 signs in with a deliberately wrong password),
# which can trip account lockout on a real user.

# A registered Bugasura account.
BUGASURA_EMAIL=qa.user@moolya.com

# Only TC_LOGIN_001 needs this. TC_LOGIN_002 runs on the email alone.
BUGASURA_PASSWORD=

# The account the CODE GENERATOR's browser signs in with while it reads the
# application. Optional: without it the generator uses BUGASURA_EMAIL /
# BUGASURA_PASSWORD above. Set it when exploration should use a different
# account from the one the tests run as.
# BUGASURA_EXPLORATION_USER=
# BUGASURA_EXPLORATION_PASSWORD=
#
# Or name a profile, and keep its secrets in the environment only:
#   BUGASURA_EXPLORATION_PROFILE=qa-user
# reads BUGASURA_QA_USER_EMAIL / BUGASURA_QA_USER_PASSWORD.
# BUGASURA_EXPLORATION_PROFILE=

# Optional overrides.
# BUGASURA_BASE_URL=https://my.bugasura.io/
# EXCEL_WORKERS=4

# Lets tests - and the code generator - exercise flows that CREATE data in the
# live workspace. Both are required; either one missing and those cases skip.
# Nothing deletes what they create, so point BUGASURA_TEAM at a team whose board
# you are willing to have projects appear on.
# BUGASURA_ALLOW_DATA_MUTATION=1
# BUGASURA_TEAM=

# Only needed if `npm run excel:autocode` cannot find Claude Code by itself.
# CLAUDE_CLI=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe
